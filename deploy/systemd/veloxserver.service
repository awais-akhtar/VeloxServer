[Unit]
Description=VeloxServer web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veloxserver
Group=veloxserver
WorkingDirectory=/srv/veloxserver
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/veloxserver/.venv/bin/veloxserver --config /etc/veloxserver/veloxserver.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/veloxserver /run/veloxserver
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
